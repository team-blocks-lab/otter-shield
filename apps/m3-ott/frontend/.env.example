# true: Mock 데이터(백엔드 없이 화면 확인). false: Spring Boot 사용 (미설정 시 true)
VITE_USE_MOCK=true
# 비워두면 같은 출처 /api (개발은 vite 프록시 -> VITE_PROXY_TARGET, 기본 http://localhost:8081)
VITE_API_BASE_URL=
# thumbnailKey 앞에 붙일 CloudFront 주소. 비어 있으면 썸네일 대신 색 면 포스터가 표시된다.
VITE_MEDIA_BASE_URL=
# 개발용: 백엔드 연결 중 재생 API가 없을 때 로컬 public/media/elephants-dream.mp4 로 재생 (배포는 false)
VITE_LOCAL_DEMO_PLAYBACK=false
